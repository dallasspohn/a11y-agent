# Node modules
node_modules/

# Environment variables
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
# ...except the extension's F5 config, which is shared tooling, not a personal
# preference. Git will not descend into an excluded directory, so the parent
# has to be un-excluded before the file can be.
!vscode-extension/.vscode/
!vscode-extension/.vscode/launch.json
.idea/
*.swp
*.swo

# Build output
dist/
build/

# Test output
coverage/
.nyc_output/

# Playwright
test-results/
playwright-report/
playwright/.cache/

# Voice models and temp files
models/
*.mp3
*.wav
*.ogg
*.flac

# Ad-hoc scratch scripts (checked-in test harnesses live in scripts/ and tests/)
test-*.js
*-demo.js
!scripts/**
!tests/**

# Auto-fix backups
*.bak
