# Node modules
node_modules/

# Environment variables
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/*
# ...except the F5 configs, which are shared tooling rather than personal
# preference. Without them a fresh clone cannot launch the extension host.
!.vscode/launch.json
!.vscode/tasks.json
# Git will not descend into an excluded directory, so the parent has to be
# un-excluded before the files inside it can be.
!vscode-extension/.vscode/
!vscode-extension/.vscode/launch.json
!vscode-extension/.vscode/tasks.json
.idea/
*.swp
*.swo

# Build output
dist/
build/
*.vsix

# VS Code downloaded by the extension integration tests (~1GB)
.vscode-test/

# Test output
coverage/
.nyc_output/

# Playwright
test-results/
playwright-report/
playwright/.cache/

# Voice models and temp files
models/
*.mp3
*.wav
*.ogg
*.flac

# Ad-hoc scratch scripts (checked-in test harnesses live in scripts/ and tests/)
test-*.js
*-demo.js
!scripts/**
!tests/**

# Auto-fix backups
*.bak
