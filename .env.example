# AI provider for --fix suggestions
# Default: Claude API (Anthropic) - Most reliable, best results
# Get your API key from: https://console.anthropic.com/settings/keys

A11Y_AI_KEY=your-anthropic-api-key-here
A11Y_AI_MODEL=claude-3-5-sonnet-20241022

# Local AI (Ollama/RamaLama) - For offline development
# Uncomment A11Y_AI_URL to use local models instead:
# A11Y_AI_URL=http://localhost:11434/v1
# A11Y_AI_KEY=ollama
# A11Y_AI_MODEL=llama3.1
