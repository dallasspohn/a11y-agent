# AI provider for --fix suggestions (OpenAI-compatible API)
# Defaults to local Ollama — no key needed, just run: ollama pull llama3.1

A11Y_AI_URL=http://localhost:11434/v1
A11Y_AI_KEY=ollama
A11Y_AI_MODEL=llama3.1

# OpenAI example:
# A11Y_AI_URL=https://api.openai.com/v1
# A11Y_AI_KEY=sk-...
# A11Y_AI_MODEL=gpt-4o

# Anthropic example:
# A11Y_AI_URL=https://api.anthropic.com/v1
# A11Y_AI_KEY=sk-ant-...
# A11Y_AI_MODEL=claude-sonnet-4-20250514
