{
  "name": "a11y-agent",
  "version": "0.1.0",
  "description": "Shift-left accessibility agent with voice I/O — dual-persona pipeline for visual and visually impaired developers",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "lint": "node src/lint.js",
    "scan": "node src/scan.js",
    "watch": "node src/watch.js",
    "install-hooks": "cp scripts/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit",
    "demo": "node src/scan.js --file samples/bad-page.html",
    "demo:lint": "node src/lint.js --file samples/bad-page.html",
    "demo:voice": "node src/scan.js --file samples/bad-page.html --voice",
    "demo:listen": "node src/scan.js --listen",
    "test:vosk": "node scripts/test-vosk-pipeline.js",
    "demo:watch": "node src/watch.js --dir samples/",
    "conversation": "node src/scan.js --file samples/bad-page.html --fix --interactive",
    "test": "node --test tests/*.test.js && node src/lint.js --file samples/good-page.html --fail-on minor",
    "test:extension": "npm --prefix vscode-extension test",
    "agent": "node src/agent.js",
    "agent:text": "node src/agent.js --text",
    "eval": "node evaluation/run-eval.js",
    "eval:json": "node evaluation/run-eval.js --json",
    "eval:check": "A11Y_EVAL=1 node --test tests/benchmark.test.js",
    "demo:reset": "git checkout -- samples/bad-page.html samples/web-page.html && rm -f samples/*.bak && echo 'samples/bad-page.html and samples/web-page.html restored'",
    "demo:agent": "npm run demo:reset --silent && node src/agent.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.52.0",
    "@axe-core/playwright": "^4.10.0",
    "chalk": "^5.4.1",
    "chokidar": "^4.0.1",
    "commander": "^13.1.0",
    "dotenv": "^17.4.2",
    "node-html-parser": "^7.0.1",
    "openai": "^4.73.0",
    "playwright": "^1.52.0"
  },
  "optionalDependencies": {
    "mic": "^2.1.2",
    "vosk": "^0.3.39"
  },
  "bin": {
    "a11y-agent": "./src/agent.js"
  }
}
