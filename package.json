{
  "name": "a11y-agent",
  "version": "0.1.0",
  "description": "Shift-left accessibility agent with voice I/O — dual-persona pipeline for visual and visually impaired developers",
  "type": "module",
  "scripts": {
    "lint": "node src/lint.js",
    "lint:adoc": "node src/lint-adoc.js",
    "scan": "node src/scan.js",
    "watch": "node src/watch.js",
    "install-hooks": "cp scripts/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit",
    "demo": "node src/scan.js --file samples/bad-page.html",
    "demo:lint": "node src/lint.js --file samples/bad-page.html",
    "demo:lint-adoc": "node src/lint-adoc.js --file samples/bad-lecture.adoc",
    "demo:voice": "node src/scan.js --file samples/bad-page.html --voice",
    "demo:watch": "node src/watch.js --dir samples/",
    "conversation-demo": "node src/conversation-demo.js interactive",
    "conversation-test": "node src/conversation-demo.js scripted",
    "test": "node --test tests/lint-html.test.js && node src/lint.js --file samples/good-page.html --fail-on minor"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.52.0",
    "@axe-core/playwright": "^4.10.0",
    "chalk": "^5.4.1",
    "chokidar": "^4.0.1",
    "commander": "^13.1.0",
    "node-html-parser": "^7.0.1",
    "openai": "^4.73.0",
    "playwright": "^1.52.0"
  },
  "optionalDependencies": {
    "mic": "^2.1.2",
    "vosk": "^0.3.39"
  }
}
